# Backend only. Never use EXPO_PUBLIC_ for API secrets.
AUTOHUNTER_MODE=demo
HOST=127.0.0.1
PORT=3000
AUTOHUNTER_LIVE_ENABLED=true
BRAVE_SEARCH_API_KEY=
# One request per search, at most 20 results; no automatic retries or paid pagination.
BRAVE_SEARCH_MAX_RESULTS=20
# Search results are transient only. No persistent Brave database is built.
